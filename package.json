{
  "name": "pide-un-deseo-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare:media": "node scripts/prepare-media.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "lighthouse": "latest",
    "prettier": "^3.9.9",
    "sharp": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
